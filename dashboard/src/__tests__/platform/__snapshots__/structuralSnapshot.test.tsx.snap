// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`structural snapshot — client chooser > locks the three domain cards, their tags, CTAs and routes 1`] = `
"div [data-testid="client-chooser"]
  div
    div
      p "Choose a forecasting client"
      h2 "Which forecasting problem do you want to explore?"
      p "Each client drives a live synthetic panel shaped like its real one. The verified"
  div
    div [data-testid="domain-wind"]
      span
      span "Live synthetic sandbox"
      h3 "Offshore wind"
      p "Forecast the offshore-wind power feeding the operator reserve sizing."
      p [data-testid="domain-wind-note"] "Live panel is a synthetic sandbox shaped like the wind panel - not the Elia wind"
      div
        a [data-testid="domain-wind-cta" href="#/platform/market?panel=heterogeneous"]
          span "Watch a wind-like panel"
        a [data-testid="domain-wind-evidence" href="#/evidence"] "See the verified wind evidence"
    div [data-testid="domain-electricity"]
      span
      span "Live synthetic sandbox"
      h3 "Electricity imbalance"
      p "Forecast the imbalance price consumed on the settlement side."
      p [data-testid="domain-electricity-note"] "Live panel is a synthetic sandbox shaped like the electricity panel. The mechani"
      div
        a [data-testid="domain-electricity-cta" href="#/platform/market?panel=homogeneous"]
          span "Watch a near-homogeneous panel"
        a [data-testid="domain-electricity-evidence" href="#/evidence"] "See the verified electricity evidence"
    div [data-testid="domain-air_quality"]
      span
      span "Live synthetic sandbox"
      h3 "Air quality and chemistry"
      p "Forecast hourly PM2.5 from a panel of independent chemistry-transport models."
      p [data-testid="domain-air_quality-note"] "Live panel is a synthetic sandbox shaped like a chemistry-transport panel, not t"
      div
        a [data-testid="domain-air_quality-cta" href="#/platform/market?panel=chemistry_moe"]
          span "Watch a chemistry-transport panel"
        a [data-testid="domain-air_quality-evidence" href="#/evidence"] "See the verified CAMS evidence""
`;

