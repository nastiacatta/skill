exports[`structural snapshot — transport controls > locks the play/step/scrub/speed toolbar shape 1`] = `
"div [role="toolbar" aria-label="Market playback"]
  button [type="button" aria-label="Previous round" disabled]
    span "←"
  button [data-testid="transport-toggle" type="button" aria-label="Play"]
    span "Play"
  button [type="button" aria-label="Next round"]
    span "→"
  button [type="button" aria-label="Restart"]
    span "Restart"
  input [data-testid="round-scrubber" type="range" aria-label="Scrub round"]
  div [role="group" aria-label="Playback speed"]
    span "Speed"
    button [type="button" aria-pressed="false"]
      span "Slow"
    button [type="button" aria-pressed="true"]
      span "Steady"
    button [type="button" aria-pressed="false"]
      span "Brisk"
  span [aria-live="polite"] "Round 1 / 80""
`;
