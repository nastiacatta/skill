exports[`structural snapshot — reliability diagram > locks the diagonal, axis ticks and one marker per quantile level 1`] = `
"svg [data-testid="reliability" role="img" aria-label="Calibration reliability diagram"]
  rect
  line
  text "perfect"
  g
    text "0.0"
    text "0.0"
  g
    text "0.5"
    text "0.5"
  g
    text "1.0"
    text "1.0"
  path
  circle [data-testid="reliability-point-0.1"]
  circle [data-testid="reliability-point-0.2"]
  circle [data-testid="reliability-point-0.3"]
  circle [data-testid="reliability-point-0.4"]
  circle [data-testid="reliability-point-0.5"]
  circle [data-testid="reliability-point-0.6"]
  circle [data-testid="reliability-point-0.7"]
  circle [data-testid="reliability-point-0.8"]
  circle [data-testid="reliability-point-0.9"]
  text "nominal quantile level τ"
  text "empirical coverage""
`;

